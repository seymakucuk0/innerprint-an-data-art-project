# Copy this file to `.env.local` and fill in your own value.
#
# 1. Go to https://developer.spotify.com/dashboard and create an app.
# 2. Click "Edit Settings" → add Redirect URI:  http://127.0.0.1:5173/
#    (use the exact URL the Vite dev server prints — usually 5173).
# 3. Copy the Client ID into the variable below.
# 4. Save the file as `.env.local` (it's gitignored). Restart `npm run dev`.
#
# Premium account required for full-track playback via the Web Playback SDK.

VITE_SPOTIFY_CLIENT_ID=
